# STEVANO — serve the built static site (run `npm run build` first).
# Run from this folder:  caddy run
# Replace stevano.example with your real domain (Caddy fetches a TLS cert).
#
# Local preview without a domain:  npm run preview   (Astro's built-in server)

stevano.example {
	root * ./dist
	encode zstd gzip
	file_server

	@static path *.css *.js *.woff2 *.jpg *.svg
	header @static Cache-Control "public, max-age=2592000"
	header *.html Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
