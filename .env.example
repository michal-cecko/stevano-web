# Contact form delivery via Resend (https://resend.com)
# 1. Sign up at resend.com, create an API key, paste it as RESEND_API_KEY.
# 2. CONTACT_TO = inbox that receives submissions (temp now, client's later).
# 3. (Optional) After verifying a STEVANO domain at Resend, set CONTACT_FROM
#    e.g. "STEVANO <web@stevano.tld>". Until then leave it unset and Resend
#    sends from onboarding@resend.dev — mail still lands in CONTACT_TO.
RESEND_API_KEY=
CONTACT_TO=ceckomichal@gmail.com
# CONTACT_FROM=STEVANO <web@stevano.tld>

# Monthly GA4 + Search Console report (scripts/monthly-report.mjs).
# Sent automatically by .github/workflows/monthly-report.yml — these must also
# exist as GitHub repo secrets (Settings > Secrets and variables > Actions).
# 1. GCP project: enable "Google Analytics Data API" + "Search Console API",
#    create a service account, download its JSON key.
# 2. Grant that service account's email read access in BOTH consoles:
#    GA4 > Admin > Property Access Management (Viewer), and
#    Search Console > Settings > Users and permissions.
# 3. GOOGLE_SERVICE_ACCOUNT_KEY = the whole JSON key, base64'd to one line:
#    base64 -i key.json | pbcopy      (never commit the key itself)
# Keep the account read-only: the scopes are *.readonly and it needs NO
# project-level IAM role, so a leaked key can only read this site's stats.
# To revoke: GCP > IAM > Service Accounts > Keys > delete, add a key, update
# the GOOGLE_SERVICE_ACCOUNT_KEY secret. Nothing else depends on it.
GOOGLE_SERVICE_ACCOUNT_KEY=
# GA4_PROPERTY_ID = digits only, from GA4 > Admin > Property details.
GA4_PROPERTY_ID=
# GSC_SITE_URL = the property exactly as Search Console lists it, trailing slash included.
GSC_SITE_URL=https://stevano.tld/
# REPORT_TO = who gets the report (comma-separated for several).
REPORT_TO=ceckomichal@gmail.com
# REPORT_FROM = optional; falls back to CONTACT_FROM, then onboarding@resend.dev.
# REPORT_FROM=STEVANO <reports@stevano.tld>
