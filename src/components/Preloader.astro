---
// Fullscreen logo reveal — plays once per browser session. CSS lives in
// global.css; under prefers-reduced-motion (or no-JS) content shows instantly.
// The winged crest unfolds from its centre column, then the wordmark reveals.
---
<noscript><style>.stv-pre{display:none}</style></noscript>
<div class="stv-pre" role="status" aria-label="STEVANO">
  <div class="stv-pre__logo">
    <svg class="stv-pre__mark" viewBox="0 0 642 567" fill="none" aria-hidden="true">
      <path class="stp-mk" pathLength="1" d="M308 557.326L262 506.727V340.91L308 300.891V557.326ZM380 340.91V506.727L334 557.326V300.891L380 340.91ZM380 257.8V297.559L322.325 246.503L321 245.329L319.675 246.503L262 297.559V257.8L321 195.897L380 257.8Z"></path>
      <path class="stp-mk" pathLength="1" d="M274.399 207.689L225.387 254.346L8 80.0391V9.97559L274.399 207.689ZM179.5 329.049L178.762 328.448L51 224.548V153.098L236 297.477V487.194L86 360.57V291.15L176.254 363.064L179.5 365.65V329.049Z"></path>
      <path class="stp-mk" pathLength="1" d="M591 224.548L463.238 328.448L462.5 329.049V365.65L465.746 363.064L556 291.15V360.57L406 487.194V297.477L591 153.098V224.548ZM634 80.0391L416.612 254.346L367.6 207.689L634 9.97559V80.0391Z"></path>
    </svg>
    <img class="stv-pre__wm" src="/img/stevano-logotype.svg" alt="" aria-hidden="true" width="2817" height="289" />
    <p class="stv-pre__tag" aria-hidden="true">Premium Cleaning Services</p>
  </div>
  <div class="stv-pre__bar"><i></i></div>
</div>

<script>
  const pre = document.querySelector('.stv-pre');
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Tell the scroll-reveal observer that content is now visible, so above-the-
  // fold elements (hero) animate in at the right moment.
  function signalReady() {
    (window as any).__stvReady = true;
    document.dispatchEvent(new CustomEvent('stv-ready'));
  }

  // Play the reveal only once per session — skip it on later navigations/reloads.
  let seen = false;
  try { seen = sessionStorage.getItem('stv-preloaded') === '1'; } catch (e) {}

  if (!pre || reduce || seen) {
    pre?.remove();
    signalReady(); // no intro animation → content is visible right away
  } else {
    try { sessionStorage.setItem('stv-preloaded', '1'); } catch (e) {}
    document.documentElement.classList.add('stv-pre-lock');
    document.body.classList.add('stv-pre-lock');

    let done = false;
    const dismiss = () => {
      if (done) return;
      done = true;
      signalReady(); // hero reveals as the preloader fades away
      pre.classList.add('done');
      document.documentElement.classList.remove('stv-pre-lock');
      document.body.classList.remove('stv-pre-lock');
      pre.addEventListener('transitionend', () => pre.remove(), { once: true });
      setTimeout(() => pre.remove(), 1200);
    };

    // Dismiss only after the tagline (the last element to reveal) has finished,
    // plus a hold so the complete lockup is clearly visible before it fades out.
    // This can't clip the reveal regardless of machine speed; the timeout is a
    // safety net.
    const tag = pre.querySelector('.stv-pre__tag');
    const HOLD = 750;
    if (tag) tag.addEventListener('animationend', () => setTimeout(dismiss, HOLD), { once: true });
    setTimeout(dismiss, 4200); // fallback if animationend was missed
  }
</script>
