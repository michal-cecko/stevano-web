---
// Fullscreen logo reveal — plays once per browser session. CSS lives in
// global.css; under prefers-reduced-motion (or no-JS) content shows instantly.
// The winged crest unfolds from its centre column, then the wordmark reveals.
---
<noscript><style>.stv-pre{display:none}</style></noscript>
<div class="stv-pre" role="status" aria-label="STEVANO">
  <svg class="stv-pre__mark" viewBox="-6 -6 642 567" fill="none" aria-hidden="true">
    <path class="stp-mk" pathLength="1" d="M302 551.326L256 500.727V334.91L302 294.891V551.326Z"></path>
    <path class="stp-mk" pathLength="1" d="M374 334.91V500.727L328 551.326V294.891L374 334.91Z"></path>
    <path class="stp-mk" pathLength="1" d="M374 251.8V291.559L316.325 240.503L315 239.329L313.675 240.503L256 291.559V251.8L315 189.897L374 251.8Z"></path>
    <path class="stp-mk" pathLength="1" d="M268.399 201.689L219.387 248.346L2 74.0391V3.97559L268.399 201.689Z"></path>
    <path class="stp-mk" pathLength="1" d="M173.5 323.049L172.762 322.448L45 218.548V147.098L230 291.477V481.194L80 354.57V285.15L170.254 357.064L173.5 359.65V323.049Z"></path>
    <path class="stp-mk" pathLength="1" d="M585 218.548L457.238 322.448L456.5 323.049V359.65L459.746 357.064L550 285.15V354.57L400 481.194V291.477L585 147.098V218.548Z"></path>
    <path class="stp-mk" pathLength="1" d="M628 74.0391L410.612 248.346L361.6 201.689L628 3.97559V74.0391Z"></path>
  </svg>
  <div class="stv-pre__wm"><span>S</span><span>T</span><span>E</span><span>V</span><span>A</span><span>N</span><span>O</span></div>
  <div class="stv-pre__bar"><i></i></div>
</div>

<script>
  const pre = document.querySelector('.stv-pre');
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Tell the scroll-reveal observer that content is now visible, so above-the-
  // fold elements (hero) animate in at the right moment.
  function signalReady() {
    (window as any).__stvReady = true;
    document.dispatchEvent(new CustomEvent('stv-ready'));
  }

  // Play the reveal only once per session — skip it on later navigations/reloads.
  let seen = false;
  try { seen = sessionStorage.getItem('stv-preloaded') === '1'; } catch (e) {}

  if (!pre || reduce || seen) {
    pre?.remove();
    signalReady(); // no intro animation → content is visible right away
  } else {
    try { sessionStorage.setItem('stv-preloaded', '1'); } catch (e) {}
    document.documentElement.classList.add('stv-pre-lock');
    document.body.classList.add('stv-pre-lock');

    let done = false;
    const dismiss = () => {
      if (done) return;
      done = true;
      signalReady(); // hero reveals as the preloader fades away
      pre.classList.add('done');
      document.documentElement.classList.remove('stv-pre-lock');
      document.body.classList.remove('stv-pre-lock');
      pre.addEventListener('transitionend', () => pre.remove(), { once: true });
      setTimeout(() => pre.remove(), 1200);
    };

    // Dismiss only after the LAST wordmark letter has finished revealing, plus a
    // hold so the complete logo is clearly visible. This can't clip the reveal
    // regardless of machine speed. The timeout is a safety net.
    const letters = pre.querySelectorAll('.stv-pre__wm span');
    const last = letters[letters.length - 1];
    const HOLD = 750;
    if (last) last.addEventListener('animationend', () => setTimeout(dismiss, HOLD), { once: true });
    setTimeout(dismiss, 3400); // fallback if animationend was missed
  }
</script>
