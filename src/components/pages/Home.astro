---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, STV_SERVICES, STV_SERVICE_META } from '../../i18n/data';
import { photoStyle, STEVANO_IMG } from '../../data/images';
import { SERVICE_CARDS } from '../../data/serviceIcons';
import ServiceCard from '../ServiceCard.astro';
// import ClientsMarquee from '../ClientsMarquee.astro'; // Partner logos hidden for now

const { lang } = Astro.props;
const home = getRelativeLocaleUrl(lang, '');
// Portfolio ("Selected work") shows every photo from all service galleries.
const portfolioImgs = STV_SERVICES.flatMap((s) => STV_SERVICE_META[s].img);
// Aroma diffuser range — three sizes shown in the products modal.
// Each image is a marketing banner with the size name + capacity baked in;
// the card adds coverage (not shown on the image) and a short blurb from i18n.
const AROMA_PRODUCTS = [
  { key: 'mini',   img: 'aroma_mini',   coverage: '250 m³',  contents: '250 ml' },
  { key: 'medium', img: 'aroma_medium', coverage: '500 m³',  contents: '500 ml' },
  { key: 'large',  img: 'aroma_large',  coverage: '1000 m³', contents: '1000 ml' },
];
// const star = '<path d="M12 2l3 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.9 21l1.2-6.8-5-4.9 6.9-1z"></path>'; // Reviews hidden for now
// const testimonials = [1, 2, 3]; // Reviews hidden for now
---
<!-- HERO -->
<section class="hero">
  <div class="img" style={photoStyle('hero', 'none')}></div>
  <div class="scrim"></div>
  <div class="inner">
    <p class="kick" data-reveal style="--reveal-delay:0ms">{t(lang, 'hero.kick')}</p>
    <h1 data-reveal style="--reveal-delay:90ms"><span>{t(lang, 'hero.t1')}</span> <span>{t(lang, 'hero.t2')}</span></h1>
    <p data-reveal style="--reveal-delay:180ms">{t(lang, 'hero.lede')}</p>
    <a href={`${home}#contact`} class="btn" data-reveal style="--reveal-delay:270ms">{t(lang, 'cta.contact')}</a>
  </div>
</section>

<!-- ABOUT -->
<section class="band" id="about">
  <div class="photo" data-reveal="left"><div class="img" style={photoStyle('about', 'soft')}></div></div>
  <div class="text" data-reveal="right">
    <p class="lbl">{t(lang, 'about.label')}</p>
    <h2>{t(lang, 'about.lead')}</h2>
    <p>{t(lang, 'about.detail')}</p>
  </div>
</section>

<!-- SERVICES -->
<section class="services" id="services">
  <div class="head" data-reveal>
    <p class="lbl">{t(lang, 'nav.services')}</p>
    <h2>{t(lang, 'services.title')}</h2>
  </div>
  <div class="scards">
    {SERVICE_CARDS.map((s, i) => <ServiceCard lang={lang} service={s.key} img={s.img} index={i} />)}
  </div>
</section>

<!-- AROMA & AIR CARE · HYGIENE FRESH -->
<section class="partner" id="products">
  <div class="pwrap">
    <div class="ptop">
      <div data-reveal="left">
        <p class="lbl">{t(lang, 'prod.label')}</p>
        <h2>{t(lang, 'prod.title')}<br>{t(lang, 'prod.title2')}</h2>
        <div class="pbanner">
          <svg class="chk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{t(lang, 'prod.note')}</span>
        </div>
        <p class="lede">{t(lang, 'prod.body')}</p>
        <p class="pconsult">{t(lang, 'prod.consult')}</p>
        <button class="btn" type="button" data-prod-open aria-haspopup="dialog">
          <span>{t(lang, 'prod.cta')}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </div>
      <div class="pvisual" data-reveal="right">
        <img class="pv-shot" src={STEVANO_IMG.airaroma} alt="Hygiene Fresh aroma diffusers" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<!-- PRODUCTS MODAL · aroma diffuser range -->
<div class="prod-modal" data-prod-modal role="dialog" aria-modal="true" aria-labelledby="prod-modal-title" hidden>
  <div class="prod-modal__panel" role="document">
    <button class="prod-modal__close" type="button" aria-label={t(lang, 'prod.modal.close')} data-prod-close>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="prod-modal__head">
      <p class="lbl">{t(lang, 'prod.label')}</p>
      <h2 id="prod-modal-title">{t(lang, 'prod.modal.title')}</h2>
      <p class="prod-modal__lede">{t(lang, 'prod.modal.lede')}</p>
    </div>
    <div class="prod-modal__body">
      <div class="prod-grid">
        {AROMA_PRODUCTS.map((p) => (
          <article class="prod-card">
            <div class="prod-card__shot">
              <img src={STEVANO_IMG[p.img]} alt={`Hygiene Fresh ${t(lang, `prod.${p.key}.name`)} aroma diffuser`} loading="lazy" />
            </div>
            <div class="prod-card__body">
              <dl class="prod-card__specs">
                <div class="prod-card__spec"><dt>{t(lang, 'prod.spec.coverage')}</dt><dd>{p.coverage}</dd></div>
                <div class="prod-card__spec"><dt>{t(lang, 'prod.spec.volume')}</dt><dd>{p.contents}</dd></div>
              </dl>
              <p class="prod-card__desc">{t(lang, `prod.${p.key}.d`)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>

<!-- PORTFOLIO -->
<section class="port" id="portfolio">
  <div class="head" data-reveal>
    <p class="lbl">{t(lang, 'nav.portfolio')}</p>
    <h2>{t(lang, 'port.title')}</h2>
  </div>
  <div class="mosaic">
    {portfolioImgs.map((key, i) => (
      <div class="photo" data-reveal style={`--reveal-delay:${(i % 4) * 70}ms;${photoStyle(key, 'none')}`} data-lb data-lb-group="portfolio" data-src={STEVANO_IMG[key]}></div>
    ))}
  </div>
</section>

<!-- TESTIMONIALS -->
{/* Reviews hidden for now
<section class="fb" id="testimonials">
  <div class="head" data-reveal>
    <p class="lbl">{t(lang, 'fb.label')}</p>
    <h2>{t(lang, 'fb.title')}</h2>
  </div>
  <div class="fbgrid">
    {testimonials.map((n) => (
      <div class="fbcard" data-reveal style={`--reveal-delay:${(n - 1) * 90}ms`}>
        <div class="stars">
          {[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24" fill="currentColor" set:html={star}></svg>)}
        </div>
        <p class="quote">{t(lang, `fb.${n}.q`)}</p>
        <div class="who"><span class="n">{t(lang, `fb.${n}.a`)}</span><span class="r">{t(lang, `fb.${n}.r`)}</span></div>
      </div>
    ))}
  </div>
</section>
*/}

<!-- CLIENTS -->
{/* Partner logos hidden for now
<section class="clients">
  <p class="lbl">{t(lang, 'clients.label')}</p>
  <ClientsMarquee />
</section>
*/}

<!-- CONTACT -->
<section class="contact" id="contact">
  <div class="img" style={photoStyle('hotel_corridor', 'veil')}></div>
  <div class="inner">
    <div data-reveal="left">
      <h2>{t(lang, 'contact.title')}</h2>
      <div class="cinfo">
        <div><div class="l">{t(lang, 'contact.email')}</div><div class="v"><a href="mailto:infostevano@gmail.eu">infostevano@gmail.eu</a><br><a href="mailto:stevano.sro@icloud.com">stevano.sro@icloud.com</a></div></div>
        <div><div class="l">{t(lang, 'contact.phone')}</div><div class="v"><a href="tel:+32467884458">+32 467 88 44 58</a></div></div>
        <div><div class="l">{t(lang, 'contact.address')}</div><div class="v">Dolné Rudiny 2956/8, Žilina</div></div>
      </div>
    </div>
    <form id="contact-form" data-reveal="right">
      <div><label>{t(lang, 'form.name')}</label><input name="name" type="text" required /></div>
      <div><label>{t(lang, 'form.email')}</label><input name="email" type="email" required /></div>
      <div><label>{t(lang, 'form.message')}</label><textarea name="message" required></textarea></div>
      {/* honeypot — hidden from humans, filled by bots; submissions with it set are dropped */}
      <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;" />
      <button class="btn" type="submit">{t(lang, 'form.submit')}</button>
      <p class="form-status" role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<script>
  // Products modal — aroma diffuser range. Opened from the [data-prod-open] button.
  const pModal = document.querySelector('[data-prod-modal]') as HTMLElement | null;
  const pOpeners = Array.from(document.querySelectorAll<HTMLElement>('[data-prod-open]'));
  if (pModal && pOpeners.length) {
    const panel = pModal.querySelector('.prod-modal__panel') as HTMLElement;
    const closeBtn = pModal.querySelector('[data-prod-close]') as HTMLElement;
    let pLastFocus: HTMLElement | null = null;

    const openModal = (trigger: HTMLElement) => {
      pLastFocus = trigger;
      pModal.hidden = false;
      requestAnimationFrame(() => pModal.setAttribute('data-open', '1'));
      document.documentElement.style.overflow = 'hidden';
      closeBtn.focus();
    };
    const closeModal = () => {
      pModal.setAttribute('data-open', '0');
      document.documentElement.style.overflow = '';
      setTimeout(() => { pModal.hidden = true; }, 250);
      pLastFocus?.focus();
    };

    pOpeners.forEach((b) => b.addEventListener('click', () => openModal(b)));
    closeBtn.addEventListener('click', closeModal);
    pModal.addEventListener('click', (e) => { if (!panel.contains(e.target as Node)) closeModal(); }); // backdrop
    document.addEventListener('keydown', (e) => {
      if (pModal.getAttribute('data-open') === '1' && e.key === 'Escape') closeModal();
    });
  }

  // Contact form -> /api/contact (server endpoint sends via Resend).
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector('.form-status') as HTMLElement;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const get = (n: string) => (form.querySelector(`[name=${n}]`) as HTMLInputElement)?.value.trim() || '';
    const say = (msg: string, ok = true) => {
      status.textContent = msg;
      status.hidden = false;
      status.dataset.ok = ok ? '1' : '0';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      say('Sending…');
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: get('name'),
            email: get('email'),
            message: get('message'),
            company: get('company'), // honeypot
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) { say('Thanks — your message has been sent.'); form.reset(); }
        else say('Sorry, something went wrong. Please try again or email us directly.', false);
      } catch {
        say('Network error. Please try again or email us directly.', false);
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
