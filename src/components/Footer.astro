---
import { t, REGION_TAG } from '../i18n/data';
const { lang } = Astro.props;
---
<footer>
  <span class="ft-copy">{t(lang, 'footer')}</span>
  <span class="stv-region-tag stv-region-tag--foot" aria-label={REGION_TAG}>
    <span class="stv-region-tag__dot" aria-hidden="true"></span>{REGION_TAG}
  </span>
</footer>
