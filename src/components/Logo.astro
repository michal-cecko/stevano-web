---
// STEVANO logo lockup — winged crest mark + wordmark.
const { href = '/' , onphoto = true } = Astro.props;
---
<a class={`stv-logo${onphoto ? ' stv-logo--onphoto' : ''}`} href={href} aria-label="STEVANO">
  <svg class="stv-mark" viewBox="-6 -6 642 567" fill="none" aria-hidden="true">
    <path class="stv-mk stv-mk--c" d="M302 551.326L256 500.727V334.91L302 294.891V551.326ZM374 334.91V500.727L328 551.326V294.891L374 334.91ZM374 251.8V291.559L316.325 240.503L315 239.329L313.675 240.503L256 291.559V251.8L315 189.897L374 251.8Z"></path>
    <path class="stv-mk stv-mk--l" d="M268.399 201.689L219.387 248.346L2 74.0391V3.97559L268.399 201.689ZM173.5 323.049L172.762 322.448L45 218.548V147.098L230 291.477V481.194L80 354.57V285.15L170.254 357.064L173.5 359.65V323.049Z"></path>
    <path class="stv-mk stv-mk--r" d="M585 218.548L457.238 322.448L456.5 323.049V359.65L459.746 357.064L550 285.15V354.57L400 481.194V291.477L585 147.098V218.548ZM628 74.0391L410.612 248.346L361.6 201.689L628 3.97559V74.0391Z"></path>
  </svg>
  <span class="stv-wm"><span>S</span><span>T</span><span>E</span><span>V</span><span>A</span><span>N</span><span>O</span></span>
</a>
