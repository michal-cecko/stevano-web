---
// STEVANO logo lockup — full one-file mark + wordmark SVG.
const { href = '/' , onphoto = true } = Astro.props;
---
<a class={`stv-logo${onphoto ? ' stv-logo--onphoto' : ''}`} href={href} aria-label="STEVANO">
  <img class="stv-logo__img" src="/img/stevano-logo.svg" alt="" width="3711" height="567" />
</a>
