---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n/data';
import { SERVICE_ICONS } from '../data/serviceIcons';
import { photoStyle } from '../data/images';

const { lang, service, img, index = 0 } = Astro.props;   // service: 'hotel' | 'rest' | ...
const href = getRelativeLocaleUrl(lang, `services/${service}`);
---
<a class="scard" href={href} data-reveal style={`--reveal-delay:${index * 70}ms`}>
  <div class="img" style={`position:absolute;inset:0;${photoStyle(img, 'none')}`}></div>
  <div class="scrim"></div>
  <div class="go">→</div>
  <div class="c">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={SERVICE_ICONS[service]}></svg>
    <h3>{t(lang, `svc.${service}`)}</h3>
    <p>{t(lang, `svc.${service}.d`)}</p>
  </div>
</a>
